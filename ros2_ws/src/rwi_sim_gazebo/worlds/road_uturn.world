        <visual name="curve_inner_white_16"><pose>50.802 8.994 0.02 0 0 2.8798</pose><geometry><box><size>0.540 0.12 0.001</size></box></geometry><material><emissive>1 1 1 1</emissive></material></visual>
        <visual name="curve_inner_white_17"><pose>50.270 9.088 0.02 0 0 3.0543</pose><geometry><box><size>0.540 0.12 0.001</size></box></geometry><material><emissive>1 1 1 1</emissive></material></visual>


      </link>
    </model>

    <!-- 4. PHYSICAL BOUNDARIES (JERSEY BARRIERS) -->
    <include><name>b1</name><uri>model://jersey_barrier</uri><pose>10 -3.2 0 0 0 0</pose></include>
    <include><name>b2</name><uri>model://jersey_barrier</uri><pose>25 -3.2 0 0 0 0</pose></include>
    <include><name>b3</name><uri>model://jersey_barrier</uri><pose>40 -3.2 0 0 0 0</pose></include>

    <include><name>b4</name><uri>model://jersey_barrier</uri><pose>10 15.2 0 0 0 0</pose></include>
    <include><name>b5</name><uri>model://jersey_barrier</uri><pose>25 15.2 0 0 0 0</pose></include>
    <include><name>b6</name><uri>model://jersey_barrier</uri><pose>40 15.2 0 0 0 0</pose></include>

    <!-- 5. VEGETATION (TREES) -->
    <include><name>tree_inner_1</name><uri>model://pine_tree</uri><pose>15 6 0 0 0 0</pose></include>
    <include><name>tree_inner_2</name><uri>model://oak_tree</uri><pose>30 5 0 0 0 0</pose></include>
    <include><name>tree_inner_3</name><uri>model://oak_tree</uri><pose>45 7 0 0 0 0</pose></include>

    <include><name>tree_outer_1</name><uri>model://pine_tree</uri><pose>5 -6 0 0 0 0</pose></include>
    <include><name>tree_outer_2</name><uri>model://pine_tree</uri><pose>40 -8 0 0 0 0</pose></include>
    <include><name>tree_outer_3</name><uri>model://oak_tree</uri><pose>58 6 0 0 0 0</pose></include>
    <include><name>tree_outer_4</name><uri>model://pine_tree</uri><pose>20 20 0 0 0 0</pose></include>

    <!-- 6. CONES -->
    <include><name>c1</name><uri>model://construction_cone</uri><pose>12 -1 0 0 0 0</pose></include>
    <include><name>c2</name><uri>model://construction_cone</uri><pose>57 6 0 0 0 0</pose></include>
    <include><name>c3</name><uri>model://construction_cone</uri><pose>20 12 0 0 0 0</pose></include>

