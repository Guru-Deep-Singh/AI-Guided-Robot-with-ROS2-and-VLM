        <visual name="curve_inner_white_10"><pose>52.994 6.802 0.02 0 0 1.8326</pose><geometry><box><size>0.540 0.12 0.001</size></box></geometry><material><emissive>1 1 1 1</emissive></material></visual>
        <visual name="curve_inner_white_11"><pose>52.810 7.310 0.02 0 0 2.0071</pose><geometry><box><size>0.540 0.12 0.001</size></box></geometry><material><emissive>1 1 1 1</emissive></material></visual>
        <visual name="curve_inner_white_12"><pose>52.539 7.778 0.02 0 0 2.1817</pose><geometry><box><size>0.540 0.12 0.001</size></box></geometry><material><emissive>1 1 1 1</emissive></material></visual>
        <visual name="curve_inner_white_13"><pose>52.192 8.192 0.02 0 0 2.3562</pose><geometry><box><size>0.540 0.12 0.001</size></box></geometry><material><emissive>1 1 1 1</emissive></material></visual>
